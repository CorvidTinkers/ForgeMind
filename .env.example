# ============================================
# ForgeMind Environment Configuration
# ============================================
# Copy this file to .env and update values

# PostgreSQL
POSTGRES_USER=forgemind
POSTGRES_PASSWORD=forgemind_secret
POSTGRES_DB=forgemind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://forgemind:forgemind_secret@postgres:5432/forgemind

# MinIO (S3-compatible Object Storage)
MINIO_ROOT_USER=forgemind
MINIO_ROOT_PASSWORD=forgemind_secret
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=forgemind-datasets
MINIO_USE_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
